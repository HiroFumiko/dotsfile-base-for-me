# Font
font-family = MesloLGS NF
# Fall back to macOS's built-in Menlo; no extra font installation required.
font-family = Menlo
font-size = 13

# Base colors
background = #000000
foreground = #bbbbbb
cursor-color = #bbbbbb
cursor-text = #ffffff
selection-background = #b5d5ff
selection-foreground = #000000

# ANSI palette (classic xterm / iTerm default)
palette = 0=#000000
palette = 1=#bb0000
palette = 2=#00bb00
palette = 3=#bbbb00
palette = 4=#0000bb
palette = 5=#bb00bb
palette = 6=#00bbbb
palette = 7=#bbbbbb
palette = 8=#555555
palette = 9=#ff5555
palette = 10=#55ff55
palette = 11=#ffff55
palette = 12=#5555ff
palette = 13=#ff55ff
palette = 14=#55ffff
palette = 15=#ffffff

# Transparency (iTerm Transparency = 0.087 → opacity 0.913)
background-opacity = 0.900

# Bold / cursor behavior
bold-is-bright = true
cursor-style = block
cursor-style-blink = false

# Scrollback
scrollback-limit = 1000
