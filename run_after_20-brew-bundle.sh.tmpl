#!/bin/bash
# Brewfile checksum: {{ include "dot_Brewfile" | sha256sum }}
# Best-effort step: failures are recorded and the remaining steps still run.
# The run_after_99 summary reports the outcome at the end of the apply.
{{ include "scripts/lib-install-status.sh" }}
set -euo pipefail

step="20-brew-bundle"
input_checksum="{{ include "dot_Brewfile" | sha256sum }}"
dotfiles_begin_step "$step"
rc=0
dotfiles_load_brew_env || rc=$?
if (( rc == 0 )); then
  export DOTFILES_INPUT_CHECKSUM="$input_checksum"
  set +e
  ( {{ include "scripts/install-brew-bundle.sh" }} )
  rc=$?
  set -e
fi
if (( rc == 0 )); then
  dotfiles_record_ok "$step"
else
  dotfiles_record_fail "$step" "exit $rc"
  printf 'warn    %s failed (exit %d); continuing with remaining steps.\n' "$step" "$rc" >&2
fi
exit 0
